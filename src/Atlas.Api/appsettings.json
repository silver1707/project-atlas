{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=atlas;Username=atlas;Password=atlas_dev_password",
    "Redis": "redis:6379"
  },
  "Atlas": {
    "ApplyMigrationsOnStartup": false,
    "ImmutableXmlStoragePath": "/var/lib/atlas/fiscal-xml",
    "DefaultFiscalProvider": "sandbox",
    "DefaultCompanyId": "11111111-1111-1111-1111-111111111111",
    "DefaultBranchId": "22222222-2222-2222-2222-222222222222"
  },
  "Authentication": {
    "Authority": "http://keycloak:8080/realms/atlas",
    "Audience": "atlas-api",
    "RequireHttpsMetadata": false
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "atlas",
    "Password": "atlas_dev_password"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
