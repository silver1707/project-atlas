{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=autoparts_erp;Username=autoparts;Password=change_me",
    "Redis": ""
  },
  "Atlas": {
    "ApplyMigrationsOnStartup": false,
    "InstallationProfile": "simple",
    "EnableRedis": false,
    "EnableRabbitMq": false,
    "EnableOpenTelemetry": false,
    "ImmutableXmlStoragePath": "C:/AutoPartsErp/FiscalXml",
    "DefaultFiscalProvider": "sandbox",
    "DefaultCompanyId": "11111111-1111-1111-1111-111111111111",
    "DefaultBranchId": "22222222-2222-2222-2222-222222222222"
  },
  "LocalAuthentication": {
    "Issuer": "AutoPartsErp.Local",
    "Audience": "AutoPartsErp.Desktop",
    "SigningKey": "development-only-change-this-local-erp-signing-key-64-bytes",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "atlas",
    "Password": "autoparts_dev_password"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
